# Exclude all node_modules by default
# node_modules
node_modules/**

# Re-include specific dependencies needed at runtime:
# 1. Language server (runs as separate process)
node_modules/@ui5-language-assistant/language-server/**
!node_modules/@ui5-language-assistant/language-server/dist/**


# Exclude development artifacts
**/*.ts
**/*.map
**/*.spec.js
**/*.test.js
**/test/**
**/tests/**
coverage/**
.nyc_output/**
*.tsbuildinfo
*.log
.DS_Store
.reuse/**
lib
reports/**
resources/**
scripts/**
src/**
test/**
.gitignore
.npmrc
esbuild.js
jest.config.js
tsconfig*.json

